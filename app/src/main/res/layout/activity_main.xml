<!--Добавил для продлистывания страницы-->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="50dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/activity_padding"
        android:background="@color/app_background"
        tools:context=".MainActivity">

        <!-- Иконка приложения -->
        <ImageView
            android:id="@+id/imageViewAppIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="@string/app_icon_description"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/icon_spacing_top"/>

        <!-- Заголовок -->
        <TextView
            android:id="@+id/textViewTitle"
            style="@style/Widget.App.TextView.Display"
            android:text="@string/label_login_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="100dp"/>

        <!-- Первое поле для ввода -->
        <EditText
            android:id="@+id/editTextLogin"
            style="@style/Widget.App.EditText"
            android:hint="@string/label_login_hint"
            android:autofillHints=""
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/textViewTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Второе поле для ввода -->
        <EditText
            android:id="@+id/editTextPassword"
            style="@style/Widget.App.EditText"
            android:autofillHints=""
            android:hint="@string/label_password_hint"
            android:inputType="textPassword"
            app:layout_constraintTop_toBottomOf="@id/editTextLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Кнопка входа -->
        <Button
            android:id="@+id/buttonLogin"
            style="@style/Widget.App.Button"
            android:text="@string/label_login_button"
            app:layout_constraintTop_toBottomOf="@id/editTextPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Дополнительные поля для второй лабораторной -->
        <!-- TextView для отображения введенного текста -->
        <TextView
            android:id="@+id/textViewDisplay"
            style="@style/Widget.App.TextView.Display"
            android:text="@string/textview_default_text"
            app:layout_constraintTop_toBottomOf="@id/buttonLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Кнопка для перехода к списку -->
        <Button
            android:id="@+id/buttonOpenList"
            android:text="@string/label_open_list_button"
            style="@style/Widget.App.Button"
            app:layout_constraintTop_toBottomOf="@+id/textViewDisplay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/element_spacing_small"/>

        <!-- Кнопка для открытия фрагментов   -->
        <Button
            android:id="@+id/buttonOpenFragments"
            android:text="@string/label_open_fragments_button"
            style="@style/Widget.App.Button"
            app:layout_constraintTop_toBottomOf="@+id/buttonOpenList"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/element_spacing_small"/>

        <LinearLayout
            android:id="@+id/posts_map_buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/buttonOpenFragments"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="0dp">

            <Button
                android:id="@+id/buttonOpenNetwork"
                android:text="@string/button_start_network_activity"
                style="@style/Widget.App.Button"
                app:layout_constraintTop_toBottomOf="@+id/buttonOpenFragments"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="5dp"/>

            <!-- Кнопка для активити MVVM-паттерна -->
            <Button
                android:id="@+id/buttonOpenMVVM"
                android:text="@string/mvvm_demo"
                style="@style/Widget.App.Button"
                app:layout_constraintTop_toBottomOf="@+id/buttonOpenFragments"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="5dp"/>

            <Button
                android:id="@+id/buttonOpenMap"
                android:text="@string/button_start_map_activity"
                style="@style/Widget.App.Button"
                app:layout_constraintTop_toBottomOf="@+id/buttonOpenMVVM"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- Область для работы с внутренним хранилищем -->
        <EditText
            android:id="@+id/editTextFileContent"
            style="@style/Widget.App.EditText"
            android:autofillHints=""
            android:hint="@string/label_file_content_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/posts_map_buttons_layout" />

        <LinearLayout
            android:id="@+id/file_buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/editTextFileContent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="0dp">

            <Button
                android:id="@+id/buttonSaveInternal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_save_internal"
                android:layout_marginEnd="8dp"
                style="@style/Widget.App.Button"/>

            <Button
                android:id="@+id/buttonReadInternal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_read_internal"
                style="@style/Widget.App.Button"/>
        </LinearLayout>

        <!-- Область для работы с базой данных -->
        <LinearLayout
            android:id="@+id/db_buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/file_buttons_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/buttonAddNote"
                style="@style/Widget.App.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_text_for_db"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/buttonReadNotes"
                style="@style/Widget.App.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_read_notes"/>

            <Button
                android:id="@+id/buttonClearNotes"
                style="@style/Widget.App.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/button_clear_notes"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
