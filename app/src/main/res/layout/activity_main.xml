<!--ConstraintLayout-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_padding"
    android:background="@color/app_background"
    tools:context=".MainActivity">

    <!-- Иконка приложения -->
    <ImageView
        android:id="@+id/imageViewAppIcon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:src="@drawable/ic_app_logo"
        android:contentDescription="@string/app_icon_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/icon_spacing_top"/>

    <!-- Заголовок -->
    <TextView
        android:id="@+id/textViewTitle"
        style="@style/Widget.App.TextView.Display"
        android:text="@string/label_login_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"/>

    <!-- Первое поле для ввода -->
    <EditText
        android:id="@+id/editTextLogin"
        style="@style/Widget.App.EditText"
        android:hint="@string/label_login_hint"
        android:autofillHints=""
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Второе поле для ввода -->
    <EditText
        android:id="@+id/editTextPassword"
        style="@style/Widget.App.EditText"
        android:autofillHints=""
        android:hint="@string/label_password_hint"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/editTextLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Кнопка входа -->
    <Button
        android:id="@+id/buttonLogin"
        style="@style/Widget.App.Button"
        android:text="@string/label_login_button"
        app:layout_constraintTop_toBottomOf="@id/editTextPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Дополнительные поля для второй лабораторной -->
    <!-- TextView для отображения введенного текста -->
    <TextView
        android:id="@+id/textViewDisplay"
        style="@style/Widget.App.TextView.Display"
        android:text="@string/textview_default_text"
        app:layout_constraintTop_toBottomOf="@id/buttonLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Кнопка для перехода к списку -->
    <Button
        android:id="@+id/buttonOpenList"
        android:text="@string/label_open_list_button"
        style="@style/Widget.App.Button"
        app:layout_constraintTop_toBottomOf="@+id/textViewDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/element_spacing_large"/>

</androidx.constraintlayout.widget.ConstraintLayout>
